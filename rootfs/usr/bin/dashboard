#!/bin/sh
# MicroOS Interactive Dashboard & Control Center
# Windows 11 / macOS inspired terminal experience

ESC=$(printf '\033')
C_RESET="${ESC}[0m"
C_BOLD="${ESC}[1m"
C_CYAN="${ESC}[1;36m"
C_GREEN="${ESC}[1;32m"
C_YELLOW="${ESC}[1;33m"
C_BLUE="${ESC}[1;34m"
C_WHITE="${ESC}[1;37m"
C_RED="${ESC}[1;31m"
C_GRAY="${ESC}[0;90m"

if [ ! -t 1 ]; then
    C_RESET=""
    C_BOLD=""
    C_CYAN=""
    C_GREEN=""
    C_YELLOW=""
    C_BLUE=""
    C_WHITE=""
    C_RED=""
    C_GRAY=""
fi

pause() {
    echo ""
    printf "${C_GRAY}Press [Enter] to return to Dashboard...${C_RESET}"
    read -r dummy
}

while true; do
    clear
    cat <<EOF
${C_CYAN}╔══════════════════════════════════════════════════════════╗
║${C_WHITE}                       MICROOS                            ${C_CYAN}║
║${C_WHITE}                    CONTROL CENTER                        ${C_CYAN}║
╠══════════════════════════════════════════════════════════╣
║                                                          ║
║  ${C_GREEN}[1]${C_WHITE} macOS / Windows GUI Desktop Environment            ${C_CYAN}║
║  ${C_GREEN}[2]${C_WHITE} Snap Software Store (Apps, Utilities, Games)       ${C_CYAN}║
║  ${C_GREEN}[3]${C_WHITE} Network & Wi-Fi Management                         ${C_CYAN}║
║  ${C_GREEN}[4]${C_WHITE} System Hardware & Resource Overview                ${C_CYAN}║
║  ${C_GREEN}[5]${C_WHITE} Storage Disks & Partition Manager                  ${C_CYAN}║
║  ${C_GREEN}[6]${C_WHITE} Micro Arcade (8 Retro Terminal Games)              ${C_CYAN}║
║  ${C_GREEN}[7]${C_WHITE} System Settings, Appearance & Themes               ${C_CYAN}║
║  ${C_GREEN}[8]${C_WHITE} System Diagnostics & Network Self-Test             ${C_CYAN}║
║  ${C_GREEN}[9]${C_WHITE} Return to Terminal Shell                           ${C_CYAN}║
║  ${C_GREEN}[0]${C_WHITE} Power Management (Restart / Shut Down)             ${C_CYAN}║
║                                                          ║
╚══════════════════════════════════════════════════════════╝${C_RESET}

EOF
    printf "Select an option [0-9, q]: "
    read -r choice
    case "$choice" in
        1|desktop|gui)
            if [ -x /usr/bin/desktop ]; then
                /usr/bin/desktop
            elif [ -x /bin/desktop ]; then
                /bin/desktop
            fi
            ;;
        2|snap|store)
            if [ -x /usr/bin/snap-store ]; then
                /usr/bin/snap-store
            fi
            ;;
        3|net|wifi)
            clear
            if [ -x /usr/bin/wifi ]; then
                /usr/bin/wifi
            fi
            ;;
        4|sysinfo|info)
            clear
            if [ -x /usr/bin/sysinfo ]; then
                /usr/bin/sysinfo
            else
                uname -a
                uptime
                free -m 2>/dev/null || free
            fi
            pause
            ;;
        5|disks)
            clear
            if [ -x /usr/bin/disks ]; then
                /usr/bin/disks
                echo ""
                /usr/bin/disks info
            fi
            pause
            ;;
        6|arcade|games)
            if [ -x /usr/bin/arcade ]; then
                /usr/bin/arcade
            fi
            ;;
        7|settings)
            if [ -x /usr/bin/settings ]; then
                /usr/bin/settings
            fi
            ;;
        8|diagnostics)
            clear
            if [ -x /usr/bin/diagnostics ]; then
                /usr/bin/diagnostics
            fi
            pause
            ;;
        9|q|exit)
            clear
            echo "Exiting Control Center. Welcome back to MicroOS shell."
            break
            ;;
        0|power)
            clear
            echo "${C_YELLOW}=== POWER MANAGEMENT ===${C_RESET}"
            echo "  [1] Reboot System"
            echo "  [2] Power Off / Halt Hardware"
            echo "  [3] Cancel"
            printf "Select option [1-3]: "
            read -r pwr
            case "$pwr" in
                1) reboot ;;
                2) poweroff ;;
                *) ;;
            esac
            ;;
        *)
            echo "${C_RED}Invalid option.${C_RESET}"
            sleep 1
            ;;
    esac
done
