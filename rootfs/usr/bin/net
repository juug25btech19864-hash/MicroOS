#!/bin/sh
# MicroOS Unified Network Management System
# Real-time network interfaces, IP assignment, routing, DNS, and control dashboard

# ANSI Colors
ESC=$(printf '\033')
C_RESET="${ESC}[0m"
C_BOLD="${ESC}[1m"
C_CYAN="${ESC}[1;36m"
C_GREEN="${ESC}[1;32m"
C_YELLOW="${ESC}[1;33m"
C_RED="${ESC}[1;31m"
C_WHITE="${ESC}[1;37m"
C_GRAY="${ESC}[0;90m"

if [ ! -t 1 ]; then
    C_RESET=""
    C_BOLD=""
    C_CYAN=""
    C_GREEN=""
    C_YELLOW=""
    C_RED=""
    C_WHITE=""
    C_GRAY=""
fi

get_primary_interface() {
    # Check default route interface first
    def_if=$(ip route 2>/dev/null | grep '^default' | awk '{print $5}' | head -n1 || true)
    if [ -n "$def_if" ]; then
        echo "$def_if"
        return 0
    fi
    # Check active interfaces with IPv4
    for ifpath in /sys/class/net/*; do
        [ -e "$ifpath" ] || continue
        ifname=$(basename "$ifpath")
        [ "$ifname" = "lo" ] && continue
        if ip -4 addr show dev "$ifname" 2>/dev/null | grep -q 'inet '; then
            echo "$ifname"
            return 0
        fi
    done
    # First non-loopback interface
    for ifpath in /sys/class/net/*; do
        [ -e "$ifpath" ] || continue
        ifname=$(basename "$ifpath")
        [ "$ifname" = "lo" ] && continue
        echo "$ifname"
        return 0
    done
    echo "lo"
}

get_if_type() {
    dev="$1"
    if [ -d "/sys/class/net/$dev/wireless" ] || [ -d "/sys/class/net/$dev/phy80211" ]; then
        echo "Wi-Fi (802.11)"
    elif [ "$dev" = "lo" ]; then
        echo "Loopback"
    else
        echo "Wired Ethernet"
    fi
}

show_status_card() {
    pif=$(get_primary_interface)
    ptype=$(get_if_type "$pif")
    oper=$(cat "/sys/class/net/$pif/operstate" 2>/dev/null || echo "down")
    pip=$(ip -4 addr show dev "$pif" 2>/dev/null | grep -o 'inet [^/]*' | cut -d' ' -f2 || true)
    [ -z "$pip" ] && pip="None (Unassigned)"
    
    gw=$(ip route 2>/dev/null | grep '^default' | awk '{print $3}' | head -n1 || true)
    [ -z "$gw" ] && gw="None (Offline)"

    dns_servers=""
    if [ -f /etc/resolv.conf ]; then
        dns_servers=$(grep '^nameserver' /etc/resolv.conf 2>/dev/null | awk '{print $2}' | tr '\n' ' ' | sed 's/ $//' || true)
    fi
    [ -z "$dns_servers" ] && dns_servers="None"

    # Status string
    if [ "$oper" = "up" ] && [ "$pip" != "None (Unassigned)" ]; then
        status_str="${C_GREEN}Connected${C_CYAN}"
        if [ "$gw" != "None (Offline)" ]; then
            inet_str="${C_GREEN}Available (Online)${C_CYAN}"
        else
            inet_str="${C_YELLOW}Local Only (No Gateway)${C_CYAN}"
        fi
    else
        status_str="${C_YELLOW}Disconnected / Idle${C_CYAN}"
        inet_str="${C_RED}Offline${C_CYAN}"
    fi

    cat <<EOF
${C_CYAN}╔══════════════════════════════════════════════════════════════╗
║${C_WHITE}                       NETWORK STATUS                         ${C_CYAN}║
╠══════════════════════════════════════════════════════════════╣
║ ${C_BOLD}Interface:${C_RESET}   %-47s ${C_CYAN}║
║ ${C_BOLD}Status:${C_RESET}      %-56s ${C_CYAN}║
║ ${C_BOLD}Type:${C_RESET}        %-47s ${C_CYAN}║
║ ${C_BOLD}IP Address:${C_RESET}  %-47s ${C_CYAN}║
║ ${C_BOLD}Gateway:${C_RESET}     %-47s ${C_CYAN}║
║ ${C_BOLD}DNS:${C_RESET}         %-47s ${C_CYAN}║
║ ${C_BOLD}Internet:${C_RESET}    %-56s ${C_CYAN}║
╚══════════════════════════════════════════════════════════════╝${C_RESET}
EOF
    # Print formatted card safely with printf
}

net_status() {
    pif=$(get_primary_interface)
    ptype=$(get_if_type "$pif")
    oper=$(cat "/sys/class/net/$pif/operstate" 2>/dev/null || echo "down")
    pip=$(ip -4 addr show dev "$pif" 2>/dev/null | grep -o 'inet [^/]*' | cut -d' ' -f2 || true)
    [ -z "$pip" ] && pip="None (Unassigned)"
    
    gw=$(ip route 2>/dev/null | grep '^default' | awk '{print $3}' | head -n1 || true)
    [ -z "$gw" ] && gw="None (Offline)"

    dns_servers=""
    if [ -f /etc/resolv.conf ]; then
        dns_servers=$(grep '^nameserver' /etc/resolv.conf 2>/dev/null | awk '{print $2}' | tr '\n' ' ' | sed 's/ $//' || true)
    fi
    [ -z "$dns_servers" ] && dns_servers="None"

    is_online="${C_RED}Offline${C_RESET}"
    if [ "$oper" = "up" ] && [ "$pip" != "None (Unassigned)" ]; then
        if [ "$gw" != "None (Offline)" ]; then
            is_online="${C_GREEN}Available (Online)${C_RESET}"
        else
            is_online="${C_YELLOW}Local Network Only${C_RESET}"
        fi
    fi

    echo "${C_CYAN}╔══════════════════════════════════════════════════════════════╗"
    echo "║                      NETWORK STATUS                          ║"
    echo "╠══════════════════════════════════════════════════════════════╣${C_RESET}"
    printf "${C_CYAN}║${C_RESET}  ${C_BOLD}%-14s${C_RESET} %-43s ${C_CYAN}║\n" "Interface:" "$pif"
    printf "${C_CYAN}║${C_RESET}  ${C_BOLD}%-14s${C_RESET} %-43s ${C_CYAN}║\n" "Type:" "$ptype"
    printf "${C_CYAN}║${C_RESET}  ${C_BOLD}%-14s${C_RESET} %-43s ${C_CYAN}║\n" "Link State:" "$oper"
    printf "${C_CYAN}║${C_RESET}  ${C_BOLD}%-14s${C_RESET} %-43s ${C_CYAN}║\n" "IP Address:" "$pip"
    printf "${C_CYAN}║${C_RESET}  ${C_BOLD}%-14s${C_RESET} %-43s ${C_CYAN}║\n" "Gateway:" "$gw"
    printf "${C_CYAN}║${C_RESET}  ${C_BOLD}%-14s${C_RESET} %-43s ${C_CYAN}║\n" "DNS Servers:" "$dns_servers"
    printf "${C_CYAN}║${C_RESET}  ${C_BOLD}%-14s${C_RESET} %-43b ${C_CYAN}║\n" "Internet:" "$is_online"
    echo "${C_CYAN}╚══════════════════════════════════════════════════════════════╝${C_RESET}"
    echo ""
}

net_interfaces() {
    echo "${C_CYAN}==================== NETWORK INTERFACES ====================${C_RESET}"
    printf "%-12s %-18s %-8s %-18s %-16s\n" "INTERFACE" "TYPE" "STATE" "MAC ADDRESS" "IP ADDRESS"
    echo "----------------------------------------------------------------------------"
    for ifpath in /sys/class/net/*; do
        [ -e "$ifpath" ] || continue
        ifname=$(basename "$ifpath")
        itype=$(get_if_type "$ifname")
        state=$(cat "$ifpath/operstate" 2>/dev/null || echo "down")
        mac=$(cat "$ifpath/address" 2>/dev/null || echo "N/A")
        ip_addr=$(ip -4 addr show dev "$ifname" 2>/dev/null | grep -o 'inet [^/]*' | cut -d' ' -f2 || true)
        [ -z "$ip_addr" ] && ip_addr="None"

        if [ "$state" = "up" ]; then
            printf "%-12s %-18s ${C_GREEN}%-8s${C_RESET} %-18s ${C_CYAN}%-16s${C_RESET}\n" "$ifname" "$itype" "$state" "$mac" "$ip_addr"
        else
            printf "%-12s %-18s ${C_GRAY}%-8s${C_RESET} %-18s %-16s\n" "$ifname" "$itype" "$state" "$mac" "$ip_addr"
        fi
    done
    echo ""
}

net_ip() {
    echo "${C_CYAN}==================== IP CONFIGURATION ====================${C_RESET}"
    ip addr show 2>/dev/null || ifconfig
    echo ""
}

net_dns() {
    echo "${C_CYAN}==================== DNS CONFIGURATION ====================${C_RESET}"
    if [ -f /etc/resolv.conf ]; then
        echo "Configuration file: /etc/resolv.conf"
        grep -E 'nameserver|search|domain' /etc/resolv.conf || cat /etc/resolv.conf
    else
        echo "${C_YELLOW}[NOTICE] No /etc/resolv.conf present.${C_RESET}"
    fi
    echo ""
}

net_route() {
    echo "${C_CYAN}==================== KERNEL ROUTING TABLE ====================${C_RESET}"
    ip route show 2>/dev/null || route -n 2>/dev/null || netstat -rn 2>/dev/null || true
    echo ""
}

net_restart() {
    echo "${C_YELLOW}Restarting networking subsystem...${C_RESET}"
    # Bring up loopback
    ip link set lo up 2>/dev/null || ifconfig lo up 2>/dev/null || true

    # Scan and request DHCP on active Ethernet interfaces
    for ifpath in /sys/class/net/*; do
        [ -e "$ifpath" ] || continue
        ifname=$(basename "$ifpath")
        [ "$ifname" = "lo" ] && continue

        echo "Activating interface $ifname..."
        ip link set "$ifname" up 2>/dev/null || true
        if command -v udhcpc >/dev/null 2>&1; then
            echo "Requesting DHCP lease on $ifname..."
            udhcpc -i "$ifname" -q -n 2>&1 || true
        fi
    done
    echo "${C_GREEN}[SUCCESS] Network restart completed.${C_RESET}"
    net_status
}

net_connect() {
    target_if="$1"
    if [ -z "$target_if" ]; then
        target_if=$(get_primary_interface)
    fi
    echo "Connecting network interface '$target_if'..."
    ip link set "$target_if" up 2>/dev/null || true
    if command -v udhcpc >/dev/null 2>&1; then
        udhcpc -i "$target_if" -q -n 2>&1 || true
    fi
    echo "${C_GREEN}[SUCCESS] Interface '$target_if' brought up.${C_RESET}"
}

net_disconnect() {
    target_if="$1"
    if [ -z "$target_if" ]; then
        target_if=$(get_primary_interface)
    fi
    echo "Disconnecting network interface '$target_if'..."
    ip link set "$target_if" down 2>/dev/null || true
    echo "${C_GREEN}[SUCCESS] Interface '$target_if' brought down.${C_RESET}"
}

# Main Dispatcher
case "$1" in
    ""|status)
        net_status
        ;;
    interfaces|if)
        net_interfaces
        ;;
    ip|addr)
        net_ip
        ;;
    dns|nameserver)
        net_dns
        ;;
    route|routes)
        net_route
        ;;
    ping)
        shift
        if [ -x /usr/bin/ping ]; then
            /usr/bin/ping "$@"
        else
            ping "$@"
        fi
        ;;
    restart)
        net_restart
        ;;
    connect|up)
        net_connect "$2"
        ;;
    disconnect|down)
        net_disconnect "$2"
        ;;
    help|--help|-h)
        cat <<EOF
Usage: net [command] [options]

Commands:
  net (or net status)        Display real-time network status dashboard
  net interfaces             List network interfaces, MACs, states, and types
  net ip                     Display IP address assignments
  net dns                    Display DNS nameserver configuration
  net route                  Display kernel routing table & default gateway
  net ping <host>            Test connectivity to target host or IP
  net restart                Restart network services & request new DHCP lease
  net connect [iface]        Bring up network interface and run DHCP
  net disconnect [iface]     Bring down network interface
EOF
        ;;
    *)
        echo "${C_RED}[ERROR] Unknown net subcommand: '$1'.${C_RESET}"
        echo "Type ${C_CYAN}net help${C_RESET} or ${C_CYAN}help net${C_RESET} for usage."
        exit 1
        ;;
esac
