#!/bin/sh
# MicroOS Wi-Fi Management Utility
# Native wireless networking controller with interactive menu & direct CLI

set -e

IWD_DIR="/var/lib/iwd"
STATE_FILE="/run/wifi.state"
RESOLV_CONF="/etc/resolv.conf"

# ANSI colors
C_RESET="\033[0m"
C_BOLD="\033[1m"
C_CYAN="\033[1;36m"
C_GREEN="\033[1;32m"
C_YELLOW="\033[1;33m"
C_RED="\033[1;31m"
C_GRAY="\033[0;90m"

if [ ! -t 1 ]; then
    C_RESET=""
    C_BOLD=""
    C_CYAN=""
    C_GREEN=""
    C_YELLOW=""
    C_RED=""
    C_GRAY=""
fi

get_wifi_interface() {
    for ifpath in /sys/class/net/*; do
        [ -e "$ifpath" ] || continue
        if [ -d "$ifpath/wireless" ] || [ -d "$ifpath/phy80211" ]; then
            basename "$ifpath"
            return 0
        fi
    done
    return 1
}

check_rfkill() {
    wlan_if="$1"
    # Attempt unblocking if rfkill is installed
    if command -v rfkill >/dev/null 2>&1; then
        rfkill unblock wifi 2>/dev/null || true
        rfkill unblock all 2>/dev/null || true
    fi
    # Check sysfs rfkill states
    for rf in /sys/class/rfkill/*; do
        [ -d "$rf" ] || continue
        rftype=$(cat "$rf/type" 2>/dev/null || true)
        if [ "$rftype" = "wlan" ]; then
            soft=$(cat "$rf/soft" 2>/dev/null || echo 0)
            hard=$(cat "$rf/hard" 2>/dev/null || echo 0)
            if [ "$hard" -eq 1 ]; then
                echo "${C_RED}[WARN] Hardware Wi-Fi switch is turned OFF on this machine.${C_RESET}"
                return 1
            fi
            if [ "$soft" -eq 1 ]; then
                echo 0 > "$rf/soft" 2>/dev/null || true
            fi
        fi
    done
    return 0
}

ensure_iwd() {
    mkdir -p "$IWD_DIR"
    chmod 700 "$IWD_DIR"

    if ! pgrep -x iwd >/dev/null 2>&1; then
        if [ -x /usr/libexec/iwd ]; then
            /usr/libexec/iwd >/tmp/iwd.log 2>&1 &
            sleep 1
        elif [ -x /usr/sbin/iwd ]; then
            /usr/sbin/iwd >/tmp/iwd.log 2>&1 &
            sleep 1
        elif command -v iwd >/dev/null 2>&1; then
            iwd >/tmp/iwd.log 2>&1 &
            sleep 1
        fi
    fi
}

wifi_status() {
    echo "${C_CYAN}==================== MICROOS WI-FI & NETWORK STATUS ====================${C_RESET}"
    wlan_if=$(get_wifi_interface || true)

    if [ -n "$wlan_if" ]; then
        mac=$(cat "/sys/class/net/$wlan_if/address" 2>/dev/null || echo "Unknown")
        state=$(cat "/sys/class/net/$wlan_if/operstate" 2>/dev/null || echo "DOWN")
        driver=$(basename "$(readlink -f "/sys/class/net/$wlan_if/device/driver" 2>/dev/null || echo "Unknown")")

        echo "  ${C_BOLD}Wi-Fi Interface:${C_RESET}     ${C_GREEN}$wlan_if${C_RESET} (Physical 802.11 Radio)"
        echo "  ${C_BOLD}Driver:${C_RESET}             $driver"
        echo "  ${C_BOLD}MAC Address:${C_RESET}        $mac"
        echo "  ${C_BOLD}Link State:${C_RESET}         $state"

        ip_addr=$(ip -4 addr show dev "$wlan_if" 2>/dev/null | grep -o 'inet [^/]*' | cut -d' ' -f2 || true)
        if [ -n "$ip_addr" ]; then
            echo "  ${C_BOLD}Assigned IP:${C_RESET}        ${C_GREEN}$ip_addr${C_RESET}"
        else
            echo "  ${C_BOLD}Assigned IP:${C_RESET}        ${C_YELLOW}Not assigned (Disconnected)${C_RESET}"
        fi

        if [ -f "$STATE_FILE" ]; then
            echo "  ${C_BOLD}Active SSID:${C_RESET}        ${C_CYAN}$(cat "$STATE_FILE")${C_RESET}"
        fi
    else
        echo "  ${C_BOLD}Wi-Fi Radio:${C_RESET}        ${C_YELLOW}No 802.11 wireless radio detected.${C_RESET}"
        echo "  ${C_GRAY}------------------------------------------------------------${C_RESET}"
        echo "  ${C_CYAN}[INFO] VirtualBox & Virtual Environments:${C_RESET}"
        echo "  Oracle VirtualBox emulates a wired Ethernet adapter (Intel PRO/1000)."
        echo "  Physical 802.11 Wi-Fi radios activate automatically when booting on native laptops."
    fi

    echo ""
    echo "  ${C_BOLD}Ethernet Adapters:${C_RESET}"
    found_eth=0
    for ethpath in /sys/class/net/*; do
        [ -e "$ethpath" ] || continue
        eif=$(basename "$ethpath")
        [ "$eif" = "lo" ] && continue
        [ "$eif" = "$wlan_if" ] && continue

        found_eth=1
        emac=$(cat "$ethpath/address" 2>/dev/null || echo "Unknown")
        estate=$(cat "$ethpath/operstate" 2>/dev/null || echo "DOWN")
        edriver=$(basename "$(readlink -f "$ethpath/device/driver" 2>/dev/null || echo "Unknown")")
        eip=$(ip -4 addr show dev "$eif" 2>/dev/null | grep -o 'inet [^/]*' | cut -d' ' -f2 || true)

        echo "    * ${C_GREEN}$eif${C_RESET}: Link=$estate | MAC=$emac | Driver=$edriver ${eip:+(IP: $eip)}"
    done
    [ "$found_eth" -eq 0 ] && echo "    (No wired Ethernet interfaces detected)"
    echo ""
}

wifi_info() {
    wlan_if=$(get_wifi_interface || true)
    if [ -z "$wlan_if" ]; then
        echo "${C_YELLOW}[NOTICE] No physical Wi-Fi hardware detected.${C_RESET}"
        echo "In VirtualBox, the emulated wired adapter is used."
        return 0
    fi
    echo "${C_CYAN}=== WI-FI ADAPTER SPECIFICATIONS ===${C_RESET}"
    echo "  Interface:        $wlan_if"
    echo "  Hardware Path:    $(readlink -f "/sys/class/net/$wlan_if")"
    echo "  Driver:           $(basename "$(readlink -f "/sys/class/net/$wlan_if/device/driver")")"
    echo "  MAC Address:      $(cat "/sys/class/net/$wlan_if/address" 2>/dev/null || echo 'Unknown')"
    echo "  MTU:              $(cat "/sys/class/net/$wlan_if/mtu" 2>/dev/null || echo '1500')"
}

wifi_scan() {
    wlan_if=$(get_wifi_interface || true)
    if [ -z "$wlan_if" ]; then
        echo "${C_RED}[ERROR] No physical Wi-Fi radio detected on this machine.${C_RESET}"
        echo "Notice: In Oracle VirtualBox, use the emulated Ethernet adapter ('net' or 'net status')."
        echo "Physical Wi-Fi hardware requires booting directly on a laptop."
        return 1
    fi

    check_rfkill "$wlan_if" || return 1
    ip link set "$wlan_if" up 2>/dev/null || true

    echo "${C_CYAN}Scanning for available wireless networks on $wlan_if...${C_RESET}"
    ensure_iwd

    if command -v iwctl >/dev/null 2>&1; then
        iwctl station "$wlan_if" scan 2>/dev/null || true
        sleep 2
        echo ""
        echo "${C_BOLD}Available 802.11 Networks:${C_RESET}"
        iwctl station "$wlan_if" get-networks || true
    elif command -v iw >/dev/null 2>&1; then
        iw dev "$wlan_if" scan 2>/dev/null | grep -E 'SSID:|signal:' || true
    else
        echo "${C_YELLOW}[NOTICE] Scanning hardware nl80211 endpoints...${C_RESET}"
        ip link set "$wlan_if" up
    fi
}

wifi_connect() {
    ssid="$1"
    pass="$2"

    if [ -z "$ssid" ]; then
        read -p "Enter Wi-Fi SSID (Network Name): " ssid
        if [ -z "$ssid" ]; then
            echo "${C_RED}[ERROR] SSID cannot be empty.${C_RESET}"
            return 1
        fi
    fi

    wlan_if=$(get_wifi_interface || true)
    if [ -z "$wlan_if" ]; then
        echo "${C_RED}[ERROR] Cannot connect: No physical Wi-Fi adapter detected.${C_RESET}"
        return 1
    fi

    check_rfkill "$wlan_if" || return 1
    ip link set "$wlan_if" up 2>/dev/null || true

    # Secure interactive password prompt if not supplied via --password flag
    if [ -z "$pass" ]; then
        # Check if argument 2 was --password
        if [ "$2" = "--password" ] && [ -n "$3" ]; then
            pass="$3"
        else
            printf "Enter password for '%s' (leave blank for open network): " "$ssid"
            stty -echo 2>/dev/null || true
            read -r pass
            stty echo 2>/dev/null || true
            echo ""
        fi
    fi

    ensure_iwd
    echo "${C_CYAN}Associating with '$ssid' on $wlan_if...${C_RESET}"

    # Configure iwd profile with 0600 security
    if [ -n "$pass" ]; then
        (
            umask 077
            cat <<EOF > "$IWD_DIR/${ssid}.psk"
[Security]
Passphrase=$pass
EOF
        )
    fi

    if command -v iwctl >/dev/null 2>&1; then
        if [ -n "$pass" ]; then
            iwctl --passphrase "$pass" station "$wlan_if" connect "$ssid" 2>&1 || true
        else
            iwctl station "$wlan_if" connect "$ssid" 2>&1 || true
        fi
    fi

    echo "${C_CYAN}Acquiring IP address via DHCP (udhcpc)...${C_RESET}"
    if command -v udhcpc >/dev/null 2>&1; then
        udhcpc -i "$wlan_if" -q -n 2>&1 || true
    fi

    # Set fallback DNS if empty
    if [ ! -s "$RESOLV_CONF" ]; then
        cat <<EOF > "$RESOLV_CONF"
nameserver 8.8.8.8
nameserver 1.1.1.1
EOF
    fi

    echo "$ssid" > "$STATE_FILE"
    echo "${C_GREEN}[SUCCESS] Connected to '$ssid'.${C_RESET}"
}

wifi_disconnect() {
    wlan_if=$(get_wifi_interface || true)
    if [ -n "$wlan_if" ]; then
        if command -v iwctl >/dev/null 2>&1; then
            iwctl station "$wlan_if" disconnect 2>/dev/null || true
        fi
        ip link set "$wlan_if" down 2>/dev/null || true
    fi
    rm -f "$STATE_FILE"
    echo "${C_GREEN}[SUCCESS] Disconnected from Wi-Fi.${C_RESET}"
}

wifi_menu() {
    while true; do
        cat <<EOF
${C_CYAN}╔══════════════════════════════════════════════════╗
║               WI-FI MANAGEMENT                   ║
╚══════════════════════════════════════════════════╝${C_RESET}

  ${C_BOLD}[1]${C_RESET} Scan Networks
  ${C_BOLD}[2]${C_RESET} Connect to Network
  ${C_BOLD}[3]${C_RESET} Disconnect
  ${C_BOLD}[4]${C_RESET} Connection Status
  ${C_BOLD}[5]${C_RESET} Wi-Fi Adapter Information
  ${C_BOLD}[6]${C_RESET} Return to MicroOS Shell

EOF
        printf "Select an option [1-6]: "
        read -r choice
        case "$choice" in
            1) wifi_scan ;;
            2) wifi_connect ;;
            3) wifi_disconnect ;;
            4) wifi_status ;;
            5) wifi_info ;;
            6|q|quit|exit) break ;;
            *) echo "${C_RED}Invalid option. Enter 1-6.${C_RESET}" ;;
        esac
        echo ""
        printf "Press [Enter] to continue..."
        read -r dummy
        clear
    done
}

# Main CLI Dispatcher
case "$1" in
    "")
        wifi_menu
        ;;
    status)
        wifi_status
        ;;
    info)
        wifi_info
        ;;
    scan)
        wifi_scan
        ;;
    connect)
        shift
        # Handle --password flag if present in args
        target_ssid="$1"
        target_pass=""
        shift || true
        while [ $# -gt 0 ]; do
            case "$1" in
                --password|-p)
                    target_pass="$2"
                    shift 2
                    ;;
                *)
                    if [ -z "$target_pass" ]; then
                        target_pass="$1"
                    fi
                    shift
                    ;;
            esac
        done
        wifi_connect "$target_ssid" "$target_pass"
        ;;
    disconnect)
        wifi_disconnect
        ;;
    help|--help|-h)
        cat <<EOF
Usage: wifi [command] [options]

Commands:
  wifi                              Open interactive Wi-Fi management menu
  wifi status                       Display Wi-Fi and Ethernet network status
  wifi scan                         Scan for nearby 802.11 SSIDs
  wifi connect <SSID>               Connect with secure interactive password prompt
  wifi connect <SSID> --password <P> Connect supplying password directly
  wifi disconnect                   Disconnect active wireless association
  wifi info                         Display Wi-Fi hardware adapter details
EOF
        ;;
    *)
        echo "${C_RED}[ERROR] Unknown wifi subcommand: '$1'.${C_RESET}"
        echo "Type ${C_CYAN}wifi help${C_RESET} or ${C_CYAN}help wifi${C_RESET} for usage."
        exit 1
        ;;
esac
