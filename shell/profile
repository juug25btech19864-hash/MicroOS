# /etc/profile for MicroOS v2.0
# System-wide environment, modern terminal styling, and command aliases

export PATH="/usr/local/bin:/usr/bin:/bin:/usr/local/sbin:/usr/sbin:/sbin:/usr/games:/mnt/ssd/debian-root/usr/bin"
export LD_LIBRARY_PATH="/lib:/usr/lib:/lib64:/usr/lib64:/mnt/ssd/debian-root/usr/lib"
export TERM="${TERM:-linux}"
export HOME="/root"
export USER="micro"
export SHELL="/bin/sh"

# Modern Windows Terminal / macOS Terminal Inspired Prompt
# Format: micro@micro ~ $ (in bold cyan, blue path, emerald prompt glyph)
export PS1='\[\033[1;36m\]micro@micro \[\033[1;34m\]\w \[\033[1;32m\]$ \[\033[0m\]'

# Command Aliases
alias cls='clear'
alias ll='ls -la'
alias la='ls -A'
alias l='ls -CF'
alias info='sysinfo'
alias netinfo='net status'
alias games='arcade'
alias restart='reboot'
alias shutdown='poweroff'
alias control='settings'
alias umount='unmount'

# Display modern branded welcome banner on interactive login
if [ -t 0 ] && [ -z "$MICROOS_INITIALIZED" ]; then
    export MICROOS_INITIALIZED=1
    printf "\033[H\033[2J"
    cat <<'EOF'
┌──────────────────────────────────────────────────────────────┐
│                           MICROOS                            │
│               MINIMAL LINUX. MAXIMUM CONTROL.                │
└──────────────────────────────────────────────────────────────┘

Welcome to MicroOS v2.0!

  * Type 'dashboard'   to launch the interactive Control Center
  * Type 'help'        for the complete command reference
  * Type 'net'         for network status & configuration
  * Type 'wifi'        for Wi-Fi management
  * Type 'arcade'      to play 8 built-in retro terminal games
  * Type 'diagnostics' to run automated system health checks

EOF
fi
