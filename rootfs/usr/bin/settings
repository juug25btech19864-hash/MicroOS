#!/bin/sh
# MicroOS System Settings & Control Panel
# Interactive configuration for network, system, display, and power

ESC=$(printf '\033')
C_RESET="${ESC}[0m"
C_BOLD="${ESC}[1m"
C_CYAN="${ESC}[1;36m"
C_GREEN="${ESC}[1;32m"
C_YELLOW="${ESC}[1;33m"
C_WHITE="${ESC}[1;37m"
C_RED="${ESC}[1;31m"
C_GRAY="${ESC}[0;90m"

if [ ! -t 1 ]; then
    C_RESET=""
    C_BOLD=""
    C_CYAN=""
    C_GREEN=""
    C_YELLOW=""
    C_WHITE=""
    C_RED=""
    C_GRAY=""
fi

pause() {
    echo ""
    printf "${C_GRAY}Press [Enter] to return to Settings...${C_RESET}"
    read -r dummy
}

while true; do
    printf "\033[H\033[2J"
    cat <<EOF
${C_CYAN}╔══════════════════════════════════════════════════╗
║${C_WHITE}                 MICROOS SETTINGS                 ${C_CYAN}║
║${C_WHITE}                  CONTROL PANEL                   ${C_CYAN}║
╠══════════════════════════════════════════════════╣
║                                                  ║
║  ${C_GREEN}[1]${C_RESET} Network & IP Configuration                  ${C_CYAN}║
║  ${C_GREEN}[2]${C_RESET} Wi-Fi Connections                           ${C_CYAN}║
║  ${C_GREEN}[3]${C_RESET} System Information & Hardware               ${C_CYAN}║
║  ${C_GREEN}[4]${C_RESET} Storage & Partition Manager                 ${C_CYAN}║
║  ${C_GREEN}[5]${C_RESET} Hostname Configuration                      ${C_CYAN}║
║  ${C_GREEN}[6]${C_RESET} Date & Time Settings                        ${C_CYAN}║
║  ${C_GREEN}[7]${C_RESET} Terminal Color & Theme                      ${C_CYAN}║
║  ${C_GREEN}[8]${C_RESET} Run System Diagnostics                      ${C_CYAN}║
║  ${C_GREEN}[9]${C_RESET} Power & Reboot Options                      ${C_CYAN}║
║  ${C_GREEN}[0]${C_RESET} Exit Settings                               ${C_CYAN}║
║                                                  ║
╚══════════════════════════════════════════════════╝${C_RESET}

EOF
    printf "Select setting [0-9]: "
    read -r choice
    case "$choice" in
        1)
            printf "\033[H\033[2J"
            if [ -x /usr/bin/net ]; then
                /usr/bin/net status
                echo ""
                /usr/bin/net interfaces
            fi
            echo ""
            echo "Options: [r]estart network, [d]ns view, [Enter] back"
            printf "Choice: "
            read -r nopt
            case "$nopt" in
                r|R) /usr/bin/net restart 2>/dev/null || true; pause ;;
                d|D) /usr/bin/net dns 2>/dev/null || true; pause ;;
                *) ;;
            esac
            ;;
        2)
            if [ -x /usr/bin/wifi ]; then
                /usr/bin/wifi
            fi
            ;;
        3)
            printf "\033[H\033[2J"
            if [ -x /usr/bin/hardware ]; then
                /usr/bin/hardware
            fi
            pause
            ;;
        4)
            printf "\033[H\033[2J"
            if [ -x /usr/bin/disks ]; then
                /usr/bin/disks info
            fi
            pause
            ;;
        5)
            printf "\033[H\033[2J"
            echo "${C_CYAN}Current Hostname:${C_RESET} $(hostname 2>/dev/null || cat /etc/hostname 2>/dev/null)"
            printf "Enter new hostname (leave blank to keep current): "
            read -r new_host
            if [ -n "$new_host" ]; then
                echo "$new_host" > /etc/hostname 2>/dev/null || true
                hostname "$new_host" 2>/dev/null || true
                echo "${C_GREEN}[SUCCESS] Hostname updated to '$new_host'.${C_RESET}"
            fi
            pause
            ;;
        6)
            printf "\033[H\033[2J"
            echo "${C_CYAN}Current System Date & Time:${C_RESET} $(date)"
            echo "Format to set date: MMDDhhmmYYYY (e.g. 112114302026 for Nov 21 14:30 2026)"
            printf "Enter new datetime (or press Enter to skip): "
            read -r new_date
            if [ -n "$new_date" ]; then
                date "$new_date" 2>/dev/null || true
                echo "${C_GREEN}Date updated: $(date)${C_RESET}"
            fi
            pause
            ;;
        7)
            printf "\033[H\033[2J"
            echo "${C_CYAN}=== TERMINAL COLOR THEMES ===${C_RESET}"
            echo "  [1] MicroOS Cyan / Emerald (Default)"
            echo "  [2] macOS Monokai Green"
            echo "  [3] Windows Terminal Azure Blue"
            echo "  [4] Amber Retro CRT"
            printf "Select theme [1-4]: "
            read -r theme_choice
            case "$theme_choice" in
                1) export PS1='\[\033[1;36m\]micro@micro\[\033[0m\]:\[\033[1;32m\]\w\[\033[0m\]\$ ' ;;
                2) export PS1='\[\033[1;32m\]micro@micro\[\033[0m\] \[\033[1;35m\]\w\[\033[0m\] \$ ' ;;
                3) export PS1='\[\033[1;34m\]micro@micro\[\033[0m\] \[\033[1;37m\]\w\[\033[0m\] > ' ;;
                4) export PS1='\[\033[1;33m\]micro@micro\[\033[0m\]:\[\033[0;33m\]\w\[\033[0m\]# ' ;;
            esac
            echo "${C_GREEN}Theme applied for active session.${C_RESET}"
            pause
            ;;
        8)
            printf "\033[H\033[2J"
            if [ -x /usr/bin/diagnostics ]; then
                /usr/bin/diagnostics
            fi
            pause
            ;;
        9)
            printf "\033[H\033[2J"
            echo "  [1] Reboot MicroOS"
            echo "  [2] Power Off System"
            echo "  [3] Cancel"
            printf "Choice: "
            read -r pwr_opt
            case "$pwr_opt" in
                1) reboot ;;
                2) poweroff ;;
                *) ;;
            esac
            ;;
        0|q|exit)
            break
            ;;
        *)
            echo "Invalid option."
            sleep 1
            ;;
    esac
done
