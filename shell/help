#!/bin/sh
# MicroOS Dynamic Command Reference & Help System
# Provides formatted, colorized command references and detailed per-command help

# ANSI color codes
ESC=$(printf '\033')
C_RESET="${ESC}[0m"
C_BOLD="${ESC}[1m"
C_CYAN="${ESC}[1;36m"
C_GREEN="${ESC}[1;32m"
C_YELLOW="${ESC}[1;33m"
C_BLUE="${ESC}[1;34m"
C_MAGENTA="${ESC}[1;35m"
C_WHITE="${ESC}[1;37m"
C_RED="${ESC}[1;31m"
C_GRAY="${ESC}[0;90m"

# Graceful degradation if terminal doesn't support color or in pipe
if [ ! -t 1 ]; then
    C_RESET=""
    C_BOLD=""
    C_CYAN=""
    C_GREEN=""
    C_YELLOW=""
    C_BLUE=""
    C_MAGENTA=""
    C_WHITE=""
    C_RED=""
    C_GRAY=""
fi

show_general_help() {
    cat <<EOF
${C_CYAN}╔══════════════════════════════════════════════════════════════════╗
║${C_WHITE}                            MICROOS                               ${C_CYAN}║
║${C_WHITE}                       COMMAND REFERENCE                          ${C_CYAN}║
║${C_GRAY}                Minimal Linux. Maximum Control.                   ${C_CYAN}║
╚══════════════════════════════════════════════════════════════════╝${C_RESET}

${C_YELLOW}SYSTEM & GUI${C_RESET}
  ${C_GREEN}desktop${C_RESET} (gui)         Launch macOS / Windows-style TUI Desktop GUI
  ${C_GREEN}help${C_RESET} [cmd]            Display command reference or help for [cmd]
  ${C_GREEN}clear${C_RESET} (cls)           Clear the terminal console display
  ${C_GREEN}sysinfo${C_RESET} (info)        Display system overview, CPU, RAM & metrics
  ${C_GREEN}dashboard${C_RESET}             Open modern Windows/macOS-style Control Center
  ${C_GREEN}settings${C_RESET} (control)    Open system & hardware configuration menu
  ${C_GREEN}hostname${C_RESET}              Display or set system network hostname
  ${C_GREEN}uptime${C_RESET}                Display system running time and load averages
  ${C_GREEN}date${C_RESET}                  Display or configure system date and time

${C_YELLOW}APPLICATIONS & STORE${C_RESET}
  ${C_GREEN}snap${C_RESET} (store)          Open MicroOS Snap Software Center
  ${C_GREEN}snap install${C_RESET} <pkg>    Install a package (APT / Snap backend)
  ${C_GREEN}snap find${C_RESET} <query>     Search software repository catalog
  ${C_GREEN}snap list${C_RESET}             List installed applications & tools

${C_YELLOW}NETWORK${C_RESET}
  ${C_GREEN}net${C_RESET}                   Network manager & live status dashboard
  ${C_GREEN}wifi${C_RESET}                  Wi-Fi manager (interactive menu & CLI)
  ${C_GREEN}ping${C_RESET} <host>           Test network connectivity with latency stats
  ${C_GREEN}ip${C_RESET}                    Display or configure IP addresses & links
  ${C_GREEN}diagnostics${C_RESET}           Run automated system & network health checks

${C_YELLOW}HARDWARE${C_RESET}
  ${C_GREEN}hardware${C_RESET}              Hardware discovery & system device audit
  ${C_GREEN}hardware cpu${C_RESET}          Processor architecture, cores, and clock speed
  ${C_GREEN}hardware memory${C_RESET}       Physical RAM capacity, free memory, and buffers
  ${C_GREEN}hardware network${C_RESET}      Network controllers, MAC addresses, and drivers
  ${C_GREEN}hardware storage${C_RESET}      Storage controllers (NVMe, SATA, USB) & disks
  ${C_GREEN}hardware usb${C_RESET}          USB root hubs and attached peripheral devices
  ${C_GREEN}hardware pci${C_RESET}          PCI and PCIe bus controller enumeration

${C_YELLOW}STORAGE${C_RESET}
  ${C_GREEN}disks${C_RESET}                 List detected storage drives, sizes, and buses
  ${C_GREEN}disks info${C_RESET}            Detailed disk partitions and filesystem tables
  ${C_GREEN}mount${C_RESET} <dev> [dir]     Safely mount storage (Read-Only safety fallback)
  ${C_GREEN}unmount${C_RESET} <dev|dir>     Flush write caches and cleanly unmount storage

${C_YELLOW}PACKAGE MANAGEMENT${C_RESET}
  ${C_GREEN}apt status${C_RESET}            Inspect persistent package storage environment
  ${C_GREEN}apt update${C_RESET}            Synchronize package index from Debian mirrors
  ${C_GREEN}apt search${C_RESET} <pkg>      Search package repository for software
  ${C_GREEN}apt install${C_RESET} <pkg>     Install software package to persistent SSD
  ${C_GREEN}apt remove${C_RESET} <pkg>      Remove installed package from persistent SSD

${C_YELLOW}ARCADE (OFFLINE RETRO GAMES)${C_RESET}
  ${C_GREEN}arcade${C_RESET} (games)        Open interactive Micro Arcade launcher
  ${C_GREEN}snake${C_RESET}                 Play classic Snake (WASD / Arrows)
  ${C_GREEN}tetris${C_RESET}                Play Tetris falling blocks puzzle
  ${C_GREEN}pong${C_RESET}                  Play Pong paddle table tennis
  ${C_GREEN}mines${C_RESET}                 Play Minesweeper puzzle
  ${C_GREEN}2048${C_RESET}                  Play 2048 sliding number puzzle
  ${C_GREEN}guess${C_RESET}                 Play Number Guessing with difficulty modes
  ${C_GREEN}tictactoe${C_RESET}             Play Tic-Tac-Toe vs Minimax AI or 2-player
  ${C_GREEN}spaceinvaders${C_RESET}         Play Space Invaders arcade shooter

${C_YELLOW}SYSTEM CONTROL${C_RESET}
  ${C_GREEN}reboot${C_RESET} (restart)      Flush storage buffers and restart system
  ${C_GREEN}poweroff${C_RESET} (shutdown)   Safely unmount drives and shut down hardware

${C_GRAY}Tip: Type ${C_WHITE}help <command>${C_GRAY} for detailed usage (e.g. ${C_CYAN}help wifi${C_GRAY}, ${C_CYAN}help net${C_GRAY}, ${C_CYAN}help ping${C_GRAY}).${C_RESET}
EOF
}

show_command_help() {
    cmd="$1"
    case "$cmd" in
        wifi)
            cat <<EOF
${C_CYAN}======================================================================
COMMAND: wifi — MicroOS Native Wireless Network Controller
======================================================================${C_RESET}

${C_YELLOW}DESCRIPTION:${C_RESET}
  Manages Wi-Fi adapters, scans for 802.11 access points, and establishes
  secure WPA2/WPA3 wireless connections via the Linux networking stack.

${C_YELLOW}SYNTAX:${C_RESET}
  ${C_GREEN}wifi${C_RESET}                              Open interactive Wi-Fi menu
  ${C_GREEN}wifi scan${C_RESET}                         Scan for nearby wireless networks (SSIDs)
  ${C_GREEN}wifi status${C_RESET}                       Display wireless radio, link, and IP state
  ${C_GREEN}wifi connect${C_RESET} <SSID>               Connect with secure interactive password prompt
  ${C_GREEN}wifi connect${C_RESET} <SSID> --password <P> Connect supplying password directly
  ${C_GREEN}wifi disconnect${C_RESET}                   Disconnect active wireless association

${C_YELLOW}SECURITY:${C_RESET}
  Interactive password input is masked and never written to shell history or logs.
  Credentials are stored with restrictive 0600 permissions in /var/lib/iwd.

${C_YELLOW}EXAMPLES:${C_RESET}
  wifi
  wifi scan
  wifi connect MyHomeWiFi
  wifi connect OfficeNet --password SecretKey123
  wifi disconnect
EOF
            ;;
        ping)
            cat <<EOF
${C_CYAN}======================================================================
COMMAND: ping — MicroOS Network Diagnostic Tool
======================================================================${C_RESET}

${C_YELLOW}DESCRIPTION:${C_RESET}
  Sends ICMP ECHO_REQUEST packets to network hosts or IP addresses to verify
  network layer connectivity, packet loss, and round-trip latency.

${C_YELLOW}SYNTAX:${C_RESET}
  ${C_GREEN}ping${C_RESET} <host_or_ip>                 Send continuous pings (Ctrl+C to stop)
  ${C_GREEN}ping -c${C_RESET} <count> <host_or_ip>         Send specific number of packets
  ${C_GREEN}ping -4${C_RESET} <host_or_ip>                 Force IPv4 resolution
  ${C_GREEN}ping -6${C_RESET} <host_or_ip>                 Force IPv6 resolution

${C_YELLOW}OFFLINE DIAGNOSTICS:${C_RESET}
  If the network is unreachable or no default gateway is active, ping produces
  descriptive diagnostic hints rather than cryptic failures.

${C_YELLOW}EXAMPLES:${C_RESET}
  ping 127.0.0.1
  ping 8.8.8.8
  ping -c 4 google.com
  ping -c 5 1.1.1.1
EOF
            ;;
        net)
            cat <<EOF
${C_CYAN}======================================================================
COMMAND: net — MicroOS Unified Network Management System
======================================================================${C_RESET}

${C_YELLOW}DESCRIPTION:${C_RESET}
  Provides a unified dashboard and controller for wired Ethernet, Wi-Fi,
  IP address assignment, routing tables, and DNS configuration.

${C_YELLOW}SYNTAX:${C_RESET}
  ${C_GREEN}net${C_RESET} (or ${C_GREEN}net status${C_RESET})               Display modern network status dashboard
  ${C_GREEN}net interfaces${C_RESET}                   List all physical and virtual interfaces
  ${C_GREEN}net ip${C_RESET}                           Display current IPv4 and IPv6 addresses
  ${C_GREEN}net dns${C_RESET}                          Show nameservers configured in /etc/resolv.conf
  ${C_GREEN}net route${C_RESET}                        Display kernel routing table and default gateway
  ${C_GREEN}net ping${C_RESET} <host>                   Test reachability of target host or IP
  ${C_GREEN}net restart${C_RESET}                      Restart networking services & release/renew DHCP
  ${C_GREEN}net connect${C_RESET} [interface]          Bring up network interface and run DHCP
  ${C_GREEN}net disconnect${C_RESET} [interface]       Bring down network interface

${C_YELLOW}EXAMPLES:${C_RESET}
  net
  net interfaces
  net ip
  net dns
  net route
  net restart
EOF
            ;;
        hardware)
            cat <<EOF
${C_CYAN}======================================================================
COMMAND: hardware — MicroOS Automatic Hardware Discovery
======================================================================${C_RESET}

${C_YELLOW}DESCRIPTION:${C_RESET}
  Performs real-time, non-destructive hardware inspection by parsing Linux
  sysfs and procfs structures.

${C_YELLOW}SYNTAX:${C_RESET}
  ${C_GREEN}hardware${C_RESET}                          Complete system hardware summary
  ${C_GREEN}hardware cpu${C_RESET}                      CPU model, architecture, cores, and clock
  ${C_GREEN}hardware memory${C_RESET}                   RAM capacity, utilization, buffers, cache
  ${C_GREEN}hardware network${C_RESET}                  Ethernet and Wi-Fi adapters & drivers
  ${C_GREEN}hardware storage${C_RESET}                  NVMe, SATA, USB controllers and disks
  ${C_GREEN}hardware usb${C_RESET}                      USB root hubs and connected peripherals
  ${C_GREEN}hardware pci${C_RESET}                      PCI/PCIe bus devices and loaded modules
EOF
            ;;
        disks)
            cat <<EOF
${C_CYAN}======================================================================
COMMAND: disks — MicroOS Storage Inspection
======================================================================${C_RESET}

${C_YELLOW}DESCRIPTION:${C_RESET}
  Scans all attached storage media (NVMe, SATA SSD/HDD, USB flash drives)
  and presents drive models, capacities, and partition topologies.

${C_YELLOW}SYNTAX:${C_RESET}
  ${C_GREEN}disks${C_RESET}                             Display drive table (device, model, size, bus)
  ${C_GREEN}disks info${C_RESET}                        Detailed partition maps, UUIDs, filesystems
EOF
            ;;
        mount|safe_mount)
            cat <<EOF
${C_CYAN}======================================================================
COMMAND: mount — MicroOS Safe Storage Mounting
======================================================================${C_RESET}

${C_YELLOW}DESCRIPTION:${C_RESET}
  Mounts storage partitions with automatic filesystem detection. If a
  read-write mount fails or the filesystem is unclean, it automatically
  falls back to safe Read-Only mode to prevent data corruption.

${C_YELLOW}SYNTAX:${C_RESET}
  ${C_GREEN}mount${C_RESET}                             List active block device mounts
  ${C_GREEN}mount${C_RESET} <device> [target]           Mount partition (defaults to /mnt/ssd or /mnt/usb)
  ${C_GREEN}mount${C_RESET} [options] <dev> <target>    Standard BusyBox mount pass-through

${C_YELLOW}EXAMPLES:${C_RESET}
  mount
  mount /dev/sda1
  mount /dev/nvme0n1p1 /mnt/ssd
EOF
            ;;
        unmount|umount|safe_unmount)
            cat <<EOF
${C_CYAN}======================================================================
COMMAND: unmount — MicroOS Safe Storage Unmounting
======================================================================${C_RESET}

${C_YELLOW}DESCRIPTION:${C_RESET}
  Flushes write buffers (sync) and cleanly unmounts storage filesystems.
  Features automatic lazy-unmount fallback if open file handles persist.

${C_YELLOW}SYNTAX:${C_RESET}
  ${C_GREEN}unmount${C_RESET} <mountpoint_or_device>

${C_YELLOW}EXAMPLES:${C_RESET}
  unmount /mnt/ssd
  unmount /dev/sda1
EOF
            ;;
        apt)
            cat <<EOF
${C_CYAN}======================================================================
COMMAND: apt — MicroOS Persistent Debian Package Manager
======================================================================${C_RESET}

${C_YELLOW}DESCRIPTION:${C_RESET}
  Manages Debian-compatible packages within the persistent storage overlay
  (/mnt/ssd/debian-root), preserving base ISO cleanliness and size limit.

${C_YELLOW}SYNTAX:${C_RESET}
  ${C_GREEN}apt status${C_RESET}                        Check persistent storage & database readiness
  ${C_GREEN}apt init${C_RESET}                          Initialize persistent directory tree on SSD
  ${C_GREEN}apt update${C_RESET}                        Refresh package lists from Debian mirror
  ${C_GREEN}apt search${C_RESET} <package>               Search available packages
  ${C_GREEN}apt install${C_RESET} <package>              Download and install package to persistent SSD
  ${C_GREEN}apt remove${C_RESET} <package>               Uninstall package from persistent SSD
EOF
            ;;
        dashboard)
            cat <<EOF
${C_CYAN}======================================================================
COMMAND: dashboard — MicroOS Modern Control Center
======================================================================${C_RESET}

${C_YELLOW}DESCRIPTION:${C_RESET}
  Interactive terminal-based Control Center inspired by Windows 11 and macOS.
  Provides a unified graphical-style menu for quick access to system monitoring,
  networking, storage, arcade games, settings, and power control.

${C_YELLOW}SYNTAX:${C_RESET}
  ${C_GREEN}dashboard${C_RESET}
EOF
            ;;
        settings|control)
            cat <<EOF
${C_CYAN}======================================================================
COMMAND: settings (or control) — MicroOS System Configuration
======================================================================${C_RESET}

${C_YELLOW}DESCRIPTION:${C_RESET}
  Interactive menu for configuring hostname, network, date/time, display colors,
  power options, and running diagnostic tests.

${C_YELLOW}SYNTAX:${C_RESET}
  ${C_GREEN}settings${C_RESET}
  ${C_GREEN}control${C_RESET}
EOF
            ;;
        diagnostics)
            cat <<EOF
${C_CYAN}======================================================================
COMMAND: diagnostics — MicroOS Automated Diagnostics Engine
======================================================================${C_RESET}

${C_YELLOW}DESCRIPTION:${C_RESET}
  Performs real-time comprehensive diagnostics on network interfaces, IP assignment,
  default gateway, DNS resolution, internet connectivity, and hardware drivers.

${C_YELLOW}SYNTAX:${C_RESET}
  ${C_GREEN}diagnostics${C_RESET}
EOF
            ;;
        arcade)
            cat <<EOF
${C_CYAN}======================================================================
COMMAND: arcade — Micro Arcade Retro Games Launcher
======================================================================${C_RESET}

${C_YELLOW}DESCRIPTION:${C_RESET}
  Interactive terminal menu launching 8 built-in retro arcade games.
  All games are written in C, run 100% offline, and require no graphics server.

${C_YELLOW}GAMES INCLUDED:${C_RESET}
  1. ${C_GREEN}snake${C_RESET}          - Classic Snake (WASD / Arrows)
  2. ${C_GREEN}tetris${C_RESET}         - Falling blocks puzzle (A/D/W/S)
  3. ${C_GREEN}pong${C_RESET}           - Paddle bounce table tennis
  4. ${C_GREEN}mines${C_RESET}          - Minesweeper grid sweeper
  5. ${C_GREEN}2048${C_RESET}           - 2048 sliding number merge
  6. ${C_GREEN}guess${C_RESET}          - Number guessing game
  7. ${C_GREEN}tictactoe${C_RESET}      - Tic-Tac-Toe vs Minimax AI or 2-player
  8. ${C_GREEN}spaceinvaders${C_RESET}  - ASCII Space Invaders shooter
EOF
            ;;
        sysinfo|info)
            cat <<EOF
${C_CYAN}======================================================================
COMMAND: sysinfo — MicroOS System Dashboard
======================================================================${C_RESET}

${C_YELLOW}DESCRIPTION:${C_RESET}
  Displays comprehensive operating system overview: kernel release, uptime,
  CPU model and core count, RAM utilization, network links, and storage status.

${C_YELLOW}SYNTAX:${C_RESET}
  ${C_GREEN}sysinfo${C_RESET}
EOF
            ;;
        clear|cls)
            echo "Usage: clear (or cls) — Clears the terminal screen."
            ;;
        reboot|restart)
            echo "Usage: reboot (or restart) — Flushes filesystems and cleanly reboots the machine."
            ;;
        poweroff|shutdown)
            echo "Usage: poweroff (or shutdown) — Unmounts storage and halts hardware power."
            ;;
        *)
            echo "${C_RED}[ERROR] No specific help manual found for '$cmd'.${C_RESET}"
            echo ""
            echo "Available commands with dedicated manuals:"
            echo "  wifi, net, ping, hardware, disks, mount, unmount, apt,"
            echo "  dashboard, settings, diagnostics, arcade, sysinfo, reboot, poweroff"
            echo ""
            echo "Type ${C_CYAN}help${C_RESET} to view the full command reference."
            return 1
            ;;
    esac
}

if [ -n "$1" ]; then
    show_command_help "$1"
else
    show_general_help
fi
