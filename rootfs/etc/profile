# /etc/profile for MicroOS
# System-wide environment and startup scripts

export PATH="/usr/local/bin:/usr/bin:/bin:/usr/local/sbin:/usr/sbin:/sbin:/usr/games:/mnt/ssd/debian-root/usr/bin"
export LD_LIBRARY_PATH="/lib:/usr/lib:/lib64:/usr/lib64:/mnt/ssd/debian-root/usr/lib"
export TERM="${TERM:-linux}"
export HOME="/root"
export USER="micro"
export SHELL="/bin/sh"

# MicroOS Branded Prompt
export PS1='\[\033[1;32m\]micro@micro\[\033[0m\]:\[\033[1;34m\]\w\[\033[0m\]\$ '

# Aliases
alias ll='ls -la'
alias la='ls -A'
alias l='ls -CF'
alias cls='clear'
alias umount='unmount'

# Display branded welcome banner on interactive login
if [ -t 0 ] && [ -z "$MICROOS_INITIALIZED" ]; then
    export MICROOS_INITIALIZED=1
    printf "\033[H\033[2J"
    cat <<'EOF'
  __  __ _               ___  ____  
 |  \/  (_)___ _ __ ___ / _ \/ ___| 
 | |\/| | / __| '__/ _ \ | | \___ \ 
 | |  | | \__ \ | | (_) | |_| |___) |
 |_|  |_|_|___/_|  \___/ \___/|____/ 

MICROOS v1.0
Minimal Linux. Maximum control.

Welcome to MicroOS!
Type 'help' for available commands, 'sysinfo' for diagnostics,
or 'arcade' to launch retro terminal games.

EOF
fi
